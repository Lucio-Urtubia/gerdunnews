{
  "appId": "news.gerdun.app",
  "appName": "GerdûnNews",
  "webDir": "www",
  "backgroundColor": "#131a27",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#131a27",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#131a27"
    }
  }
}
